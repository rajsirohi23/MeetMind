# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit secrets.

# Flask
SECRET_KEY=change-me-to-a-random-string
DEBUG=True

# MongoDB (local default — change for Atlas)
MONGO_URI=mongodb://localhost:27017/meeting_analyzer

# Whisper model size: tiny | base | small | medium | large
# 'base' recommended for development; 'small' or 'medium' for better accuracy
WHISPER_MODEL=base

# HuggingFace models (defaults are fine for MVP)
SUMMARIZATION_MODEL=facebook/bart-large-cnn
NER_MODEL=dbmdz/bert-large-cased-finetuned-conll03-english
CLASSIFIER_MODEL=facebook/bart-large-mnli

# Upload folder
UPLOAD_FOLDER=uploads

# Email notifications (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
